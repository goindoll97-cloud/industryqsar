# Copy to .env locally: cp .env.example .env
# Government law API credential OC (never commit .env or paste keys in chats)
LAW_API_OC=
LAW_API_BASE_URL=https://www.law.go.kr/DRF

# KOSHA MSDS Lookup Service (Public Data Portal 15157612)
# Keep secret credentials only in local .env; never commit them.
KOSHA_MSDS_SERVICE_KEY=
# Provisional: confirm detail ID parameter in your current API Swagger guide.
KOSHA_MSDS_DETAIL_ID_PARAM=chemId
